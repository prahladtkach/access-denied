{
  "name": "access-denied",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --base=/access-denied/",
    "preview": "vite preview --host 127.0.0.1 --base=/access-denied/",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
